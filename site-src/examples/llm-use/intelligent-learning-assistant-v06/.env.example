# Offline is the default and does not need a key.
MODEL_MODE=offline
MODEL_PROVIDER=scripted
MODEL_NAME=learning-assistant-offline
MODEL_TIMEOUT_SECONDS=10

# Optional real-provider acceptance: copy placeholders into your shell environment.
# Never commit a real value. Both --real and ALLOW_REAL_PROVIDER=1 are required.
MODEL_BASE_URL=https://provider.example/v1/responses
MODEL_API_KEY=replace-with-runtime-secret
ALLOW_REAL_PROVIDER=0
