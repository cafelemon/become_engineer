  "cards":[
    {"id":"id-boundaries","lesson_id":"agent-engineering-05","context_id":"concept-trace-span-run","question":"request、run、trace和span有什么区别？","aliases":["四种ID为什么不能混用"],"keywords":["request","run","trace","span","四种ID"],"diagnostic":"按入口、业务运行、因果链和阶段区分。","hints":["查看 #concept-trace-span-run。","确认恢复是否跨请求。"],"example":"同run可关联多个trace。","answer":"request标识入口，run标识可恢复业务运行，trace标识一次因果链，span标识链中的一个阶段。","source":{"label":"Trace Span与Run","href":"#concept-trace-span-run"},"updated_at":"2026-07-31","recommended":true},
    {"id":"resume-correlation","lesson_id":"agent-engineering-05","context_id":"concept-trace-span-run","question":"恢复请求怎样关联崩溃前轨迹？","aliases":["新trace怎么找到旧trace"],"keywords":["恢复请求","崩溃前轨迹","新trace","旧trace"],"diagnostic":"检查两次请求是否共享run ID。","hints":["查看 #concept-trace-span-run。","按run而非单个trace查询。"],"example":"trace-A和trace-B共享run-1。","answer":"恢复请求可建立新trace，但必须复用同一run ID，管理台按run聚合前后trace。","source":{"label":"Trace Span与Run","href":"#concept-trace-span-run"},"updated_at":"2026-07-31","recommended":true},
    {"id":"span-parent","lesson_id":"agent-engineering-05","context_id":"example-one-run-three-spans","question":"parent span ID有什么用？","aliases":["检索和工具怎样形成层级"],"keywords":["parent span ID","检索","工具","层级"],"diagnostic":"检查子阶段是否指向直接父阶段。","hints":["查看 #example-one-run-three-spans。","对照三段span图。"],"example":"retrieve.parent=agent.run。","answer":"它表示阶段间的直接因果层级，让检索、工具和恢复可在同一trace中重建结构。","source":{"label":"一条Run三段Span","href":"#example-one-run-three-spans"},"updated_at":"2026-07-31","recommended":true},
    {"id":"low-cardinality","lesson_id":"agent-engineering-05","context_id":"concept-low-cardinality-redaction","question":"为什么指标不能用真实run ID做标签？","aliases":["高基数指标有什么问题"],"keywords":["真实run ID","标签","高基数指标"],"diagnostic":"检查label可能取值数量。","hints":["查看 #concept-low-cardinality-redaction。","改用route template和status class。"],"example":"/api/runs/{run_id},2xx。","answer":"每个run都不同会制造无界时间序列，增加存储和查询成本；指标应使用低基数模板维度。","source":{"label":"低基数与脱敏","href":"#concept-low-cardinality-redaction"},"updated_at":"2026-07-31","recommended":true},
    {"id":"metric-route-template","lesson_id":"agent-engineering-05","context_id":"concept-low-cardinality-redaction","question":"HTTP指标应该记录URL还是路由模板？","aliases":["状态码怎样降基数"],"keywords":["HTTP指标","路由模板","状态码","降基数"],"diagnostic":"确认真实资源ID和完整错误未进label。","hints":["查看 #concept-low-cardinality-redaction。","聚合为2xx、4xx、5xx。"],"example":"/api/runs/{run_id}。","answer":"记录路由模板和状态码类别，不记录带真实ID的URL或错误全文。","source":{"label":"低基数与脱敏","href":"#concept-low-cardinality-redaction"},"updated_at":"2026-07-31","recommended":true},
    {"id":"default-redaction","lesson_id":"agent-engineering-05","context_id":"concept-low-cardinality-redaction","question":"Agent日志默认要脱敏哪些内容？","aliases":["Prompt和工具结果能完整打日志吗"],"keywords":["Agent日志","脱敏","Prompt","工具结果"],"diagnostic":"检查统一allowlist与redact路径。","hints":["查看 #concept-low-cardinality-redaction。","搜索Authorization、Cookie和正文。"],"example":"敏感字段写为REDACTED或丢弃。","answer":"凭据、Cookie、CSRF、Prompt、query、记忆正文和工具原文默认不保存或统一脱敏。","source":{"label":"低基数与脱敏","href":"#concept-low-cardinality-redaction"},"updated_at":"2026-07-31","recommended":true},
    {"id":"sampling-policy","lesson_id":"agent-engineering-05","context_id":"deepen-observability-boundary","question":"错误和成功请求怎样采样？","aliases":["为什么错误要始终采样"],"keywords":["错误","成功请求","采样","始终采样"],"diagnostic":"区分错误保留与成功比例采样。","hints":["查看 #deepen-observability-boundary。","检查采样是否可复现。"],"example":"error=always,success=1/N。","answer":"错误始终采样以保留故障证据，成功请求按确定性比例采样控制成本。","source":{"label":"可观测性边界","href":"#deepen-observability-boundary"},"updated_at":"2026-07-31","recommended":true},
    {"id":"no-chain-of-thought","lesson_id":"agent-engineering-05","context_id":"troubleshoot-agent-observability","question":"管理台应该展示隐式思维链吗？","aliases":["trace等于模型思考过程吗"],"keywords":["管理台","隐式思维链","trace","思考过程"],"diagnostic":"区分业务事件与模型私有推理。","hints":["查看 #troubleshoot-agent-observability。","只显示显式状态和工具事件。"],"example":"展示step_kind而非隐藏推理。","answer":"不应该；trace记录显式业务状态、工具、错误和关联，不收集或展示隐式思维链。","source":{"label":"Agent可观测性排错","href":"#troubleshoot-agent-observability"},"updated_at":"2026-07-31","recommended":false},
    {"id":"evidence-budget","lesson_id":"agent-engineering-05","context_id":"deepen-observability-boundary","question":"日志越多越容易排错吗？","aliases":["为什么可观测性也是预算"],"keywords":["日志越多","排错","可观测性","预算"],"diagnostic":"权衡诊断价值、隐私、成本和保留期。","hints":["查看 #deepen-observability-boundary。","优先结构字段与稳定错误码。"],"example":"原文进入短期受控调试包。","answer":"不一定；过量原文增加泄露和成本，应保留最小结构证据，敏感调试包短期受控。","source":{"label":"可观测性边界","href":"#deepen-observability-boundary"},"updated_at":"2026-07-31","recommended":false},
    {"id":"assistant-v23","lesson_id":"agent-engineering-05","context_id":"project-learning-assistant-v23","question":"智能学习助手 v0.23 新增什么？","aliases":["Agent工程第五课做什么"],"keywords":["智能学习助手","v0.23","Agent工程第五课"],"diagnostic":"定位相对v0.22的可观测性增量。","hints":["查看 #project-learning-assistant-v23。","运行脱敏导出测试。"],"example":"trace、指标、采样、脱敏。","answer":"新增trace/span、run/request关联、低基数指标、确定性采样和默认脱敏。","source":{"label":"智能学习助手v0.23","href":"#project-learning-assistant-v23"},"updated_at":"2026-07-31","recommended":false}
