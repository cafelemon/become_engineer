  "cards":[
    {"id":"prompt-layers","lesson_id":"rag-application-engineering-06","context_id":"concept-prompt-boundaries","question":"RAG Prompt 应该怎样分层？","aliases":["文档内容能当系统指令吗"],"keywords":["RAG Prompt","分层","文档内容","系统指令"],"diagnostic":"检查系统边界、任务、证据和用户输入是否隔离。","hints":["查看 #concept-prompt-boundaries。","来源正文是不可信数据。"],"example":"system→task→evidence→question→schema。","answer":"按系统边界、任务、ACL证据、用户问题和输出Schema装配；文档只能作为数据。","source":{"label":"Prompt边界","href":"#concept-prompt-boundaries"},"updated_at":"2026-07-31","recommended":true},
    {"id":"prompt-version","lesson_id":"rag-application-engineering-06","context_id":"concept-prompt-boundaries","question":"为什么 Prompt 要保存版本？","aliases":["回答回归怎样定位Prompt变化"],"keywords":["Prompt","版本","回答回归"],"diagnostic":"检查prompt_version是否与run关联。","hints":["查看 #concept-prompt-boundaries。","版本和检索run一起保存。"],"example":"grounded-answer-v1。","answer":"它让回答变化可追到具体模板，并支持固定评估、发布比较和回滚。","source":{"label":"Prompt边界","href":"#concept-prompt-boundaries"},"updated_at":"2026-07-31","recommended":true},
    {"id":"stable-resources","lesson_id":"rag-application-engineering-06","context_id":"concept-api-resource-boundaries","question":"RAG 应用的稳定 API 资源有哪些？","aliases":["管理台按钮应该直接定义接口吗"],"keywords":["RAG","稳定 API","资源","管理台按钮"],"diagnostic":"检查来源、版本、作业、检索和会话。","hints":["查看 #concept-api-resource-boundaries。","围绕资源状态。"],"example":"source/version/job/run/session/message。","answer":"核心是知识源、文档版本、ingestion作业、检索运行、聊天会话和消息，不按页面按钮临时设计。","source":{"label":"API资源边界","href":"#concept-api-resource-boundaries"},"updated_at":"2026-07-31","recommended":true},
    {"id":"resource-hiding","lesson_id":"rag-application-engineering-06","context_id":"concept-api-resource-boundaries","question":"为什么他人来源返回 404？","aliases":["跨主体资源为什么不返回403"],"keywords":["他人来源","404","跨主体","403"],"diagnostic":"检查是否泄露资源存在性。","hints":["查看 #concept-api-resource-boundaries。","候选前执行ACL。"],"example":"resource_not_visible。","answer":"404 隐藏资源是否存在；更重要的是该内容从不进入召回、Prompt、日志或trace。","source":{"label":"API资源边界","href":"#concept-api-resource-boundaries"},"updated_at":"2026-07-31","recommended":true},
    {"id":"citation-contract","lesson_id":"rag-application-engineering-06","context_id":"example-admin-chat-flow","question":"聊天引用必须返回哪些定位字段？","aliases":["只返回source_id够吗"],"keywords":["聊天引用","定位字段","source_id"],"diagnostic":"检查版本和页块chunk。","hints":["查看 #example-admin-chat-flow。","来源会更新。"],"example":"source+version+page/block+chunk。","answer":"返回source_id、version、page或block和chunk_id，不能只指向会变化的来源。","source":{"label":"管理台聊天链路","href":"#example-admin-chat-flow"},"updated_at":"2026-07-31","recommended":true},
    {"id":"explicit-refusal","lesson_id":"rag-application-engineering-06","context_id":"example-admin-chat-flow","question":"检索不到证据时聊天接口怎样响应？","aliases":["RAG可以用模型常识填空吗"],"keywords":["检索不到","证据","拒答","模型常识"],"diagnostic":"检查refused与空引用。","hints":["查看 #example-admin-chat-flow。","不要伪造引用。"],"example":"refused:true,citations:[]。","answer":"返回明确拒答和空引用，不用未验证的模型常识补答案。","source":{"label":"管理台聊天链路","href":"#example-admin-chat-flow"},"updated_at":"2026-07-31","recommended":true},
    {"id":"admin-visibility","lesson_id":"rag-application-engineering-06","context_id":"overview-rag-application","question":"RAG 管理台应该显示哪些中间状态？","aliases":["为什么不能只显示最终答案"],"keywords":["RAG管理台","中间状态","最终答案"],"diagnostic":"检查作业、候选、上下文和引用。","hints":["查看 #overview-rag-application。","错误需要分层定位。"],"example":"job/stages/context/citations。","answer":"显示来源版本、作业状态和错误、各检索阶段候选、最终上下文、Prompt版本与引用。","source":{"label":"RAG应用闭环","href":"#overview-rag-application"},"updated_at":"2026-07-31","recommended":true},
    {"id":"ocr-failure","lesson_id":"rag-application-engineering-06","context_id":"modify-add-ingestion-failure","question":"扫描 PDF 没有文本时怎么处理？","aliases":["空PDF解析能标记成功吗"],"keywords":["扫描 PDF","文本","ocr_required","解析成功"],"diagnostic":"检查稳定错误码和active版本。","hints":["查看 #modify-add-ingestion-failure。","本批不做OCR。"],"example":"status:failed,error:ocr_required。","answer":"作业返回ocr_required且不切换active版本；本批不假装解析或引入OCR。","source":{"label":"增加失败恢复","href":"#modify-add-ingestion-failure"},"updated_at":"2026-07-31","recommended":true},
    {"id":"readiness-boundary","lesson_id":"rag-application-engineering-06","context_id":"troubleshoot-rag-application","question":"live 正常为什么 ready 仍可能失败？","aliases":["健康检查怎样区分进程和检索可用"],"keywords":["live","ready","健康检查","检索可用"],"diagnostic":"检查数据库和active index依赖。","hints":["查看 #troubleshoot-rag-application。","存活不等于就绪。"],"example":"live:200,ready:503。","answer":"进程能响应只证明存活；数据库、schema或active index不可用时ready应失败。","source":{"label":"RAG应用排错","href":"#troubleshoot-rag-application"},"updated_at":"2026-07-31","recommended":true},
    {"id":"low-cardinality-metrics","lesson_id":"rag-application-engineering-06","context_id":"troubleshoot-rag-application","question":"RAG 指标为什么不能用 query 作 label？","aliases":["source_id适合Prometheus标签吗"],"keywords":["RAG指标","query","label","source_id","Prometheus"],"diagnostic":"检查高基数和敏感内容。","hints":["查看 #troubleshoot-rag-application。","运行ID放trace。"],"example":"route/status可以，query不可以。","answer":"query、source和session取值近乎无限且可能敏感，会造成高基数；应放脱敏trace而非指标标签。","source":{"label":"RAG应用排错","href":"#troubleshoot-rag-application"},"updated_at":"2026-07-31","recommended":true},
    {"id":"evidence-boundaries","lesson_id":"rag-application-engineering-06","context_id":"deepen-delivery-boundary","question":"固定 adapter、真实数据库和浏览器测试分别证明什么？","aliases":["固定测试满分能证明生产RAG吗"],"keywords":["固定adapter","真实数据库","浏览器测试","生产RAG"],"diagnostic":"拆分流程、数据和交付证据。","hints":["查看 #deepen-delivery-boundary。","不能互相外推。"],"example":"logic/schema/usability。","answer":"分别证明确定性流程边界、真实schema/索引行为和应用可操作性；都不能单独证明生产效果与容量。","source":{"label":"交付证据边界","href":"#deepen-delivery-boundary"},"updated_at":"2026-07-31","recommended":false},
    {"id":"assistant-v30","lesson_id":"rag-application-engineering-06","context_id":"project-learning-assistant-v30","question":"智能学习助手 v0.30 新增什么？","aliases":["RAG应用工程第六课交付什么"],"keywords":["智能学习助手","v0.30","RAG应用工程第六课"],"diagnostic":"定位应用交付增量。","hints":["查看 #project-learning-assistant-v30。","运行API和浏览器。"],"example":"FastAPI+TypeScript+Compose。","answer":"新增管理台、聊天页、版本化Prompt、稳定API、拒答引用、健康指标、Compose和最终RAG schema。","source":{"label":"智能学习助手v0.30","href":"#project-learning-assistant-v30"},"updated_at":"2026-07-31","recommended":false}
  ]
